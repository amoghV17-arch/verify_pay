# Milestone Environment Configuration
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env to git.

NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:5173
DATABASE_URL=postgres://milestone:milestone@localhost:5432/milestone
SESSION_SECRET=change-me-to-a-secure-random-string-at-least-32-characters

# PayPal (mock | sandbox - live is strictly forbidden)
PAYPAL_ENV=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
DEMO_FREELANCER_PAYPAL_EMAIL=

# LLM provider (anthropic | gemini | openai-compatible | fixture)
LLM_PROVIDER=fixture
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Review and autonomy settings
REVIEW_MIN_CONFIDENCE=0.75
ASSISTED_RELEASE_WINDOW_SECONDS=20

# Bryntum Gantt package (trial | licensed)
BRYNTUM_PACKAGE=trial

# Accounts, Email & Optional OAuth
DEMO_MODE=true
EMAIL_PROVIDER=outbox
EMAIL_FROM=Milestone <noreply@milestone.local>
EMAIL_VERIFICATION=soft
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPPORT_EMAIL=


